{
  "name": "tparuyi",
  "private": false,
  "version": "0.5.9",
  "description": "TPACowork - AI Desktop Office Assistant",
  "main": "./out/main/index.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --max-warnings 56",
    "preview": "vite preview",
    "preelectron:dev": "node scripts/prepare-electron-dev-macos.mjs",
    "electron:dev": "electron-vite dev",
    "electron:build": "electron-vite build",
    "electron:preview": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:gateway-contract": "vitest run src/core/nanobotClient.test.ts src/core/nanobot/*.test.ts",
    "sync:expert-team": "node scripts/sync-expert-team.mjs",
    "prepare-python": "node scripts/download-python.mjs",
    "build:win": "npm run prepare-python && npm run electron:build && electron-builder --win --config",
    "build:mac": "npm run prepare-python && npm run electron:build && electron-builder --mac --config",
    "build:linux": "npm run prepare-python && npm run electron:build && electron-builder --linux --config"
  },
  "build": {
    "appId": "com.tparuyi.app",
    "productName": "TPACowork",
    "directories": {
      "output": "dist/installers"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "embedded-python/runtime/",
        "to": "python/",
        "filter": [
          "**/*",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!**/*.pyo",
          "!**/test/**",
          "!**/tests/**"
        ]
      },
      {
        "from": "../nanobot/",
        "to": "nanobot-src/",
        "filter": [
          "nanobot/**/*.py",
          "nanobot/templates/**/*.md",
          "nanobot/skills/**/*",
          "pyproject.toml",
          "!**/__pycache__/**",
          "!**/venv/**",
          "!**/.git/**",
          "!**/tests/**"
        ]
      },
      {
        "from": "resources/expert-teams/",
        "to": "expert-teams/",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "TPACowork-3_1024x1024.png",
        "to": "app-icon.png"
      }
    ],
    "mac": {
      "target": [
        "zip"
      ],
      "icon": "resources/icons/TPACowork-macos.png",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "TPACowork需要使用麦克风，将录音通过默认语音识别模型转换为输入文字。"
      }
    },
    "win": {
      "compression": "store",
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "TPACowork-3_512x512.png"
    },
    "linux": {
      "icon": "TPACowork-3_512x512.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@fontsource-variable/newsreader": "^5.2.10",
    "@mozilla/readability": "^0.6.0",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-separator": "^1.1.9",
    "@tanstack/react-virtual": "^3.14.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "^0.3.7",
    "immer": "^11.1.4",
    "lucide-react": "^0.575.0",
    "mermaid": "^11.16.0",
    "node-llama-cpp": "^3.18.0",
    "radix-ui": "^1.4.3",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-pdf": "^10.4.1",
    "react-syntax-highlighter": "^16.1.0",
    "remark-breaks": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^3.5.0",
    "thinking-orbs": "^0.2.0",
    "three": "^0.180.0",
    "turndown": "^7.2.2",
    "ws": "^8.21.1",
    "xlsx": "^0.18.5",
    "yaml": "^2.8.2",
    "zod": "^4.3.6",
    "zustand": "^5.0.11"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.2",
    "@electron-toolkit/utils": "^4.0.0",
    "@electron/rebuild": "^4.0.3",
    "@eslint/js": "^9.39.1",
    "@tailwindcss/postcss": "^4.2.1",
    "@tailwindcss/vite": "^4.2.1",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@types/three": "^0.180.0",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.1.10",
    "autoprefixer": "^10.4.27",
    "electron": "^34.0.0",
    "electron-builder": "^26.8.1",
    "electron-vite": "^3.1.0",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "happy-dom": "^20.7.0",
    "postcss": "^8.5.8",
    "shadcn": "^3.8.5",
    "tailwindcss": "^4.2.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.48.0",
    "vite": "^6.4.1",
    "vitest": "^4.0.18"
  }
}
